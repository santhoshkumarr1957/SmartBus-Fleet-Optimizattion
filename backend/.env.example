# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:5432/postgres
# For Supabase connection pooling (port 6543 or 5432), paste your connection string below:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Application Settings
ENVIRONMENT=development
API_V1_PREFIX=/api
PROJECT_NAME="SmartBus"

# Transit Simulator Settings
SIMULATION_INTERVAL_SECONDS=5
SIMULATION_SCENARIO=normal
